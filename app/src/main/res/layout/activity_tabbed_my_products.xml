<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 🔹 標題列 -->
    <LinearLayout
        android:id="@+id/header_MyProducts"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:padding="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/img_back_MyProducts"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="10dp"
            app:srcCompat="@drawable/back" />

        <TextView
            android:id="@+id/textView80"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:text="我的商品"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- 🔹 TabLayout -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout_MyProducts"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/white"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabTextColor="#757575"
        app:tabSelectedTextColor="@color/shopee_orange"
        app:tabIndicator="@drawable/shape_tab_indicator"
        app:tabIndicatorColor="@null"
        app:tabIndicatorHeight="3dp"
        app:tabIndicatorFullWidth="false"
        app:tabPaddingStart="16dp"
        app:tabPaddingEnd="16dp"
        app:tabRippleColor="#20FF5722"
        app:layout_constraintTop_toBottomOf="@id/header_MyProducts"/>

    <!-- 🔹 ViewPager2 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/MyProducts_viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tabLayout_MyProducts"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <Button
        android:id="@+id/btn_addproducts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_add_products"
        android:text="新增商品"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
