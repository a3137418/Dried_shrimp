<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 內部底色：白色（也可以用透明） -->
    <solid android:color="@android:color/white" />

    <!-- 外框：很淡的灰色 -->
    <stroke
        android:width="1dp"
        android:color="#22000000" />  <!-- #22 = 很淡的透明度 -->

    <!-- 內縮一點，讓字不要貼在框上 -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />
</shape>
